// 유행도감 백엔드 스키마. docs/BACKEND.md의 데이터 모델 초안을 그대로 옮긴 것.
// 확정 스펙이 아니라 초기 구현용 — 실제 사용해보면서 조정될 수 있음.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  editor
  admin
}

enum Period {
  daily
  weekly
  monthly
  yearly
}

// 아카이브 등급(2026-10-24, "데이터 수집 방안" 노션 피드백 기준). 인증마크("근거가 확인됐나")와는 다른 축으로,
// "얼마나 널리 퍼졌나"를 말함. 지금 유행 중인 밈은 판정이 이르므로 nullable — 에디터가 나중에 채움.
enum MemeGrade {
  A // 대중 유행: 당시 뉴스·방송에서 유행어/현상으로 보도됐고 시기를 특정할 수 있음
  B // 온라인 대유행: 독립 커뮤니티 2곳 이상에서 쓰인 기록이 있지만 언론 보도는 약함
  C // 커뮤니티 한정: 특정 커뮤니티 안에서만 쓰인 기록
}

enum SubmissionStatus {
  pending
  approved
  rejected
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  nickname     String
  username     String   @unique // 로그인용 아이디 (이메일과 별개)
  realName     String // 실명
  birthDate    DateTime // 생년월일
  phone        String   @unique // 휴대전화번호
  passwordHash String
  role         Role     @default(user)
  createdAt    DateTime @default(now())

  scraps            Scrap[]
  recentlyViewed    RecentlyViewed[]
  submissions       Submission[] @relation("SubmittedBy")
  reviewedSubmissions Submission[] @relation("ReviewedBy")

  @@map("users")
}

// 기존 src/data/memes.js의 MEMES 배열을 옮기는 테이블.
// 검색/필터/정렬에 쓰이는 값만 컬럼화하고, timeline/관련영상/관련인물처럼
// 상세 페이지에서 통째로 읽고 필터링은 안 하는 서술형 블록은 Json으로 둔다.
model Meme {
  id             String   @id // 기존 mock 데이터의 슬러그형 id를 그대로 재사용 (예: "ddujjonkku")
  name           String
  categories     String[]
  oneLiner       String
  whatIsIt       String
  whyPopular     String
  howToUse       String
  oneLineSummary String
  platforms      String[]
  period         String // "2025.02 ~ 진행중" 같은 사람이 읽는 텍스트. 정렬/집계엔 안 씀.
  keywords       String[]
  registeredAt   DateTime

  // 유행 지표 (당분간 에디터 수동 입력, 자동 집계 없음 — 2026-09-11 논의 결정)
  buzz   Int
  search Int
  usage  Int
  trend  Int[] // 스파크라인용 시계열

  timeline       Json // [{ date, text }]
  relatedVideos  Json // [{ title, channel }]
  relatedPeople  Json // [{ name, reason, content }]
  relatedMemeIds String[]

  // 아카이브 기록·근거(2026-10-24 추가). 전부 선택 — 과거 밈을 "검증된 아카이브"로 만들 때 채움.
  // 날짜는 2000년대 밈이 연/월 단위로만 확실한 경우가 많아서 DateTime이 아니라 "2007" / "2007.03" / "2007.03.12" 문자열.
  grade       MemeGrade?
  firstRecord Json? // { date, source, url? } — 가장 이른 확인 기록
  peak        Json? // { date, evidence, url? } — 정점 시기와 그 근거
  spreadPath  String[] @default([]) // 확산 경로, 순서대로 (예: ["디시인사이드", "다음 카페", "방송"])
  sourceLinks Json     @default("[]") // [{ title, url }] — 원본 소재(영상·효과음·짤) 링크, 재배포 대신 링크만
  unverified  String[] @default([]) // 조사했지만 확인 못 한 것 — 숨기지 않고 상세 페이지에 그대로 노출

  verification Verification?
  ranks        MemeRank[]
  scraps       Scrap[]
  recentlyViewed RecentlyViewed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("memes")
}

// 기간별 랭킹. "직접 설정" 기간은 프론트에서 해시 기반으로 즉석 생성하므로 여기 안 들어옴.
model MemeRank {
  id     String @id @default(cuid())
  meme   Meme   @relation(fields: [memeId], references: [id], onDelete: Cascade)
  memeId String
  period Period
  rank   Int
  change Int?
  isNew  Boolean @default(false)

  @@unique([memeId, period])
  @@map("meme_ranks")
}

// STRATEGY.md 2-3에서 확정한 인증마크 체크리스트를 그대로 테이블화.
// reviewedBy는 실명/핸들 텍스트로만 남김(계정 시스템과 별개) — 검수자 계정 관리 화면이
// 생기기 전까지는 User FK로 엮지 않는 게 더 단순함.
model Verification {
  id              String    @id @default(cuid())
  meme            Meme      @relation(fields: [memeId], references: [id], onDelete: Cascade)
  memeId          String    @unique
  verified        Boolean   @default(false)
  sources         String[] // 최초 출처 + 독립 출처 목록
  copyrightHolder String?
  reviewedBy      String? // 검수한 에디터 핸들
  reviewedAt      DateTime?
  changeLog       Json // [{ date, editor, note }]

  @@map("verifications")
}

model Scrap {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  meme      Meme     @relation(fields: [memeId], references: [id], onDelete: Cascade)
  memeId    String
  createdAt DateTime @default(now())

  @@unique([userId, memeId])
  @@map("scraps")
}

// 최근 본 밈. (userId, memeId) 조합당 한 행만 유지하고 볼 때마다 viewedAt만 갱신 —
// 조회 시 viewedAt 내림차순으로 최근 N개만 가져오면 됨.
model RecentlyViewed {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  meme     Meme     @relation(fields: [memeId], references: [id], onDelete: Cascade)
  memeId   String
  viewedAt DateTime @default(now())

  @@unique([userId, memeId])
  @@map("recently_viewed")
}

// STRATEGY.md 2-6 "제보 → 에디터 승인 큐" 절충안용 테이블.
// payload에 제보자가 입력한 초안(밈 이름/설명 등)을 그대로 담고, 승인되면
// 에디터가 별도로 Meme 레코드를 만든다 (자동 반영 안 함 — 검수를 거치라는 취지).
model Submission {
  id            String           @id @default(cuid())
  submittedBy   User             @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedById String
  payload       Json
  status        SubmissionStatus @default(pending)
  reviewedBy    User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())

  // 승인된 제보가 실제로 등록된 Meme의 id. 느슨한 참조로만 두고(FK 관계 없음) —
  // 채워지면 "이미 등록됨"으로 보고 큐 화면에서 재등록 버튼을 감춤(중복 등록 방지, 2026-09-13 발견).
  registeredMemeId String?

  @@map("submissions")
}

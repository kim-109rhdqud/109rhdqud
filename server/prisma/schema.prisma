// 유행도감 백엔드 스키마. docs/BACKEND.md의 데이터 모델 초안을 그대로 옮긴 것.
// 확정 스펙이 아니라 초기 구현용 — 실제 사용해보면서 조정될 수 있음.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  editor
  admin
}

enum Period {
  daily
  weekly
  monthly
  yearly
}

enum SubmissionStatus {
  pending
  approved
  rejected
}

model User {
  id       String  @id @default(cuid())
  nickname String

  // 2026-09-14부터 카카오/구글로 바로 가입도 가능해지면서(신규 계정 생성), 이 5개는 더 이상
  // 항상 값이 있다고 보장 못 함 — 소셜로 막 가입한 계정은 전부 null이었다가
  // "가입 완료" 온보딩(POST /auth/complete-profile)에서 한 번에 채워짐. 일반 폼 가입(POST /auth/signup)은
  // 여전히 이 5개를 전부 필수로 받아서 처음부터 채워진 채로 만들어짐.
  email        String?   @unique
  username     String?   @unique // 로그인용 아이디 (이메일과 별개)
  realName     String? // 실명
  birthDate    DateTime? // 생년월일
  phone        String?   @unique // 휴대전화번호
  passwordHash String? // 소셜 전용 계정(일반 비밀번호 로그인 안 씀)은 null

  role      Role     @default(user)
  createdAt DateTime @default(now())

  // 이메일 인증 (2026-09-14 추가). 토큰은 발급할 때마다 새로 덮어씀 — 재발송하면 이전 토큰은 무효화됨.
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?

  // 카카오/구글 연동용 provider user id (2026-09-14 추가). 이 컬럼이 채워져 있으면
  // "연동된 계정"이라는 뜻 — 회원가입은 여전히 일반 폼으로만 가능하고, 소셜 로그인은
  // 이미 연동된 계정에 한해서만 로그인 수단으로 동작함(신규 가입 우회 방지).
  kakaoId  String? @unique
  googleId String? @unique

  scraps            Scrap[]
  recentlyViewed    RecentlyViewed[]
  submissions       Submission[] @relation("SubmittedBy")
  reviewedSubmissions Submission[] @relation("ReviewedBy")

  @@map("users")
}

// 기존 src/data/memes.js의 MEMES 배열을 옮기는 테이블.
// 검색/필터/정렬에 쓰이는 값만 컬럼화하고, timeline/관련영상/관련인물처럼
// 상세 페이지에서 통째로 읽고 필터링은 안 하는 서술형 블록은 Json으로 둔다.
model Meme {
  id             String   @id // 기존 mock 데이터의 슬러그형 id를 그대로 재사용 (예: "ddujjonkku")
  name           String
  categories     String[]
  oneLiner       String
  whatIsIt       String
  whyPopular     String
  howToUse       String
  oneLineSummary String
  platforms      String[]
  period         String // "2025.02 ~ 진행중" 같은 사람이 읽는 텍스트. 정렬/집계엔 안 씀.
  keywords       String[]
  registeredAt   DateTime

  // 유행 지표 (당분간 에디터 수동 입력, 자동 집계 없음 — 2026-09-11 논의 결정)
  buzz   Int
  search Int
  usage  Int
  trend  Int[] // 스파크라인용 시계열

  timeline       Json // [{ date, text }]
  relatedVideos  Json // [{ title, channel }]
  relatedPeople  Json // [{ name, reason, content }]
  relatedMemeIds String[]

  verification Verification?
  ranks        MemeRank[]
  scraps       Scrap[]
  recentlyViewed RecentlyViewed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("memes")
}

// 기간별 랭킹. "직접 설정" 기간은 프론트에서 해시 기반으로 즉석 생성하므로 여기 안 들어옴.
model MemeRank {
  id     String @id @default(cuid())
  meme   Meme   @relation(fields: [memeId], references: [id], onDelete: Cascade)
  memeId String
  period Period
  rank   Int
  change Int?
  isNew  Boolean @default(false)

  @@unique([memeId, period])
  @@map("meme_ranks")
}

// STRATEGY.md 2-3에서 확정한 인증마크 체크리스트를 그대로 테이블화.
// reviewedBy는 실명/핸들 텍스트로만 남김(계정 시스템과 별개) — 검수자 계정 관리 화면이
// 생기기 전까지는 User FK로 엮지 않는 게 더 단순함.
model Verification {
  id              String    @id @default(cuid())
  meme            Meme      @relation(fields: [memeId], references: [id], onDelete: Cascade)
  memeId          String    @unique
  verified        Boolean   @default(false)
  sources         String[] // 최초 출처 + 독립 출처 목록
  copyrightHolder String?
  reviewedBy      String? // 검수한 에디터 핸들
  reviewedAt      DateTime?
  changeLog       Json // [{ date, editor, note }]

  @@map("verifications")
}

model Scrap {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  meme      Meme     @relation(fields: [memeId], references: [id], onDelete: Cascade)
  memeId    String
  createdAt DateTime @default(now())

  @@unique([userId, memeId])
  @@map("scraps")
}

// 최근 본 밈. (userId, memeId) 조합당 한 행만 유지하고 볼 때마다 viewedAt만 갱신 —
// 조회 시 viewedAt 내림차순으로 최근 N개만 가져오면 됨.
model RecentlyViewed {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  meme     Meme     @relation(fields: [memeId], references: [id], onDelete: Cascade)
  memeId   String
  viewedAt DateTime @default(now())

  @@unique([userId, memeId])
  @@map("recently_viewed")
}

// STRATEGY.md 2-6 "제보 → 에디터 승인 큐" 절충안용 테이블.
// payload에 제보자가 입력한 초안(밈 이름/설명 등)을 그대로 담고, 승인되면
// 에디터가 별도로 Meme 레코드를 만든다 (자동 반영 안 함 — 검수를 거치라는 취지).
model Submission {
  id            String           @id @default(cuid())
  submittedBy   User             @relation("SubmittedBy", fields: [submittedById], references: [id])
  submittedById String
  payload       Json
  status        SubmissionStatus @default(pending)
  reviewedBy    User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())

  // 승인된 제보가 실제로 등록된 Meme의 id. 느슨한 참조로만 두고(FK 관계 없음) —
  // 채워지면 "이미 등록됨"으로 보고 큐 화면에서 재등록 버튼을 감춤(중복 등록 방지, 2026-09-13 발견).
  registeredMemeId String?

  @@map("submissions")
}

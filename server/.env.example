# 이 파일을 복사해서 .env로 저장하고 값을 채워. .env는 git에 안 올라감(루트 .gitignore 참고).
# 새 PC에서 세션 시작할 때마다 이 파일이 없으면 여기서부터 다시 만들어야 함.

# Neon 대시보드 > Connection string에서 복사 (pooled connection 권장)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 아무 랜덤 문자열이나. openssl rand -hex 32 같은 걸로 생성 추천
JWT_SECRET="change-me"

# 로컬 개발 중인 프론트 주소 (Vite 기본 포트가 5173이지만 이 프로젝트는 5175/5176도 씀 — 실제 뜬 포트에 맞출 것)
CLIENT_ORIGIN="http://localhost:5173"

PORT=4000
NODE_ENV=development

# 이메일 인증용 (resend.com > API Keys에서 발급). 없으면 인증 메일 발송만 건너뛰고
# 나머지 기능(회원가입/로그인)은 그대로 동작함(server/src/lib/email.js 참고).
RESEND_API_KEY=""
# 도메인 인증 전까지는 이 기본값(onboarding@resend.dev)으로만 발송 가능하고,
# Resend 계정 가입 시 쓴 본인 이메일로만 실제 수신됨(스팸 방지 정책).
RESEND_FROM_EMAIL="유행도감 <onboarding@resend.dev>"
